# ==========================================
# Unity Clean Architecture .gitignore
# Bảo vệ dự án khỏi hàng gigabyte file tạm
# ==========================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Aa]ssets/AssetStoreTools*

# Visual Studio / Rider / VSCode Cache
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Build Logs & Unity Batch Logs
*.log
*.log.*
Logs/
[Ll]ogs/

# Android Native Symbol Cache (Unity 6 / Gradle CMake)
.utmp/
[._]utmp/
**/[._]utmp/
**/.utmp/

# OS & Python Cache
.DS_Store
Thumbs.db
__pycache__/
tools/__pycache__/
**/*__pycache__*

# Secrets & Environment (Offline-First Hygiene)
.env
.env.local
.env.*.local
*.keystore
*.jks
credentials.json
google-services.json
google-services*.json*
GoogleService-Info.plist
